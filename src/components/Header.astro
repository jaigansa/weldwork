---
import { SITE } from '../config';

const pathname = Astro.url.pathname;
const isTamil = pathname.startsWith('/ta');

// Construct the target URL by replacing the language prefix
let targetUrl = pathname;
if (isTamil) {
  targetUrl = pathname.replace(/^\/ta/, '/en');
} else if (pathname.startsWith('/en')) {
  targetUrl = pathname.replace(/^\/en/, '/ta');
} else {
  // Fallback for root or other pages
  targetUrl = '/ta' + pathname;
}

// Add trailing slash consistency if needed
if (!targetUrl.endsWith('/')) {
  targetUrl += '/';
}
---
<header class="app-header">
  <div class="header-logo" id="header-logo-btn">
    <img src="/icons/icon-192.png" alt={`${SITE.title} Logo`} class="logo-img" />
    <span class="logo-text">{SITE.title}</span>
  </div>
  
  <div class="header-actions">
    <a href={targetUrl} class="lang-toggle-btn" id="lang-toggle-btn" aria-label="Toggle Language" title={isTamil ? 'Switch to English' : 'தமிழுக்கு மாற்றவும்'}>
      <i data-lucide="languages" class="lang-icon"></i>
    </a>
    
    <button class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle Dark and Light Mode">
      <i data-lucide="sun" class="theme-icon sun-icon"></i>
      <i data-lucide="moon" class="theme-icon moon-icon"></i>
    </button>
  </div>
</header>

<style>
  .lang-toggle-btn {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--bg-tertiary);
    border: 1px solid var(--border-color);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    text-decoration: none;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    transition: background-color 0.3s ease, border-color 0.3s ease, transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  
  .lang-toggle-btn:hover {
    border-color: var(--accent-color);
    transform: scale(1.05);
  }
  
  .lang-toggle-btn:active {
    transform: scale(0.95);
  }
  
  .lang-icon {
    width: 18px;
    height: 18px;
  }
</style>
