---
import { type Lang } from '../utils/translations';
interface Props { lang?: Lang; accessKey?: string; }
const { lang = 'en', accessKey = '' } = Astro.props;
const ta = lang === 'ta';
---
<div class="modal-overlay hidden" id="quote-modal" aria-hidden="true" role="dialog">
  <div class="modal-container">
    <button class="modal-close" id="close-quote-modal" aria-label="Close Modal">&times;</button>

    <div class="modal-header-content">
      <h2>{ta ? 'மேற்கோள் பெறவும்' : 'Get a Quote'}</h2>
      <p>{ta ? 'விவரங்களை பகிருங்கள் — நாங்கள் விரைவில் தொடர்பு கொள்கிறோம்.' : 'Share your requirements and we will get back to you with a quote shortly.'}</p>
    </div>

    <div class="quote-product-banner hidden" id="quote-product-banner">
      <i data-lucide="package" class="quote-product-icon"></i>
      <div class="quote-product-meta">
        <span id="quote-product-title"></span>
        <small id="quote-product-rate"></small>
      </div>
    </div>

    <form id="quote-form">
      <input type="hidden" name="access_key" value={accessKey} />
      <input type="hidden" name="subject" id="quote-subject-input" value="Quote Request from WeldWork Site" />
      <input type="hidden" name="product_title" id="quote-product-input" value="" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div class="form-group">
        <label for="quote-name">{ta ? 'பெயர்' : 'Name'}</label>
        <input type="text" id="quote-name" name="name" placeholder={ta ? 'உங்கள் பெயர்' : 'Your name'} required />
      </div>

      <div class="form-group">
        <label for="quote-phone">{ta ? 'தொலைபேசி' : 'Phone'}</label>
        <input type="tel" id="quote-phone" name="phone" placeholder={ta ? 'தொலைபேசி எண்' : 'Phone number'} required pattern="[\+]?[0-9\s\-\(\)]{7,15}" title={ta ? 'சரியான தொலைபேசி எண்ணை உள்ளிடவும்' : 'Please enter a valid phone number'} />
      </div>

      <div class="form-group">
        <label for="quote-email">{ta ? 'மின்னஞ்சல் (விருப்பத்திற்கு)' : 'Email (optional)'}</label>
        <input type="email" id="quote-email" name="email" placeholder={ta ? 'உங்கள் மின்னஞ்சல்' : 'your@email.com'} />
      </div>

      <div class="form-group">
        <label for="quote-message">{ta ? 'தேவைகள்' : 'Requirements'}</label>
        <textarea id="quote-message" name="message" placeholder={ta ? 'உங்கள் தேவையை விவரிக்கவும் (அளவு, பொருள், இருப்பிடம்...)' : 'Describe what you need (size, material, location...)'} required></textarea>
      </div>

      <div class="form-group">
        <label for="quote-photos">{ta ? 'புகைப்படங்கள் (விருப்பத்திற்கு, 4 வரை)' : 'Photos (optional, up to 4)'}</label>
        <input type="file" id="quote-photos" name="photos" accept="image/*" multiple data-max-files="4" />
        <small class="field-hint">{ta ? 'உங்கள் லாரி / வேலையின் புகைப்படங்களை சேர்க்கவும்' : 'Add photos of your truck / job for a faster, accurate quote'}</small>
      </div>

      <div class="form-group captcha-group">
        <div id="turnstile-widget-quote"></div>
      </div>

      <div id="quote-form-feedback" class="form-feedback hidden"></div>

      <div class="form-group">
        <button type="submit" id="quote-submit-btn" class="submit-button">
          {ta ? 'மேற்கோள் கோரிக்கை அனுப்பு' : 'Request Quote'}
        </button>
      </div>
    </form>
  </div>
</div>
