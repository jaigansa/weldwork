---
interface Props {
  lang: 'en' | 'ta';
  title: string;
  description: string;
}

const { lang, title, description } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site).href;
const altPath = lang === 'en'
  ? Astro.url.pathname.replace(/^\/en/, '/ta')
  : Astro.url.pathname.replace(/^\/ta/, '/en');
const altURL = new URL(altPath, Astro.site).href;

const ui = lang === 'ta'
  ? { back: 'முகப்புக்குச் செல்', updated: 'கடைசியாகப் புதுப்பிக்கப்பட்ட தேதி', date: 'ஆகஸ்ட் 2026' }
  : { back: 'Back to Home', updated: 'Last updated', date: 'August 2026' };
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL}>
    <link rel="alternate" hreflang={lang} href={canonicalURL}>
    <link rel="alternate" hreflang={lang === 'en' ? 'ta' : 'en'} href={altURL}>
    <meta name="theme-color" content="#111827">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png">
    <style>
      * { box-sizing: border-box; }
      body {
        margin: 0;
        background: var(--bg-primary, #090d16);
        color: var(--text-primary, #f8fafc);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, "Noto Sans Tamil", sans-serif;
        line-height: 1.7;
        padding: 40px 20px 64px;
      }
      main { max-width: 720px; margin: 0 auto; }
      .back {
        display: inline-block;
        margin-bottom: 28px;
        color: var(--steel-blue, #06b6d4);
        text-decoration: none;
        font-size: 0.9rem;
        font-weight: 600;
      }
      .back:hover { text-decoration: underline; }
      h1 {
        color: var(--text-primary, #f8fafc);
        font-size: 1.75rem;
        line-height: 1.25;
        margin: 0 0 4px;
      }
      .updated { color: var(--text-muted, #94a3b8); font-size: 0.8rem; margin: 0 0 32px; }
      h2 {
        color: var(--steel-blue, #06b6d4);
        font-size: 1.05rem;
        margin: 32px 0 8px;
      }
      p, li { font-size: 0.92rem; color: var(--text-secondary, #94a3b8); }
      ul { padding-left: 20px; margin: 8px 0; }
      li { margin-bottom: 6px; }
      strong { color: var(--text-primary, #f8fafc); }
      a { color: var(--steel-blue, #06b6d4); }
      footer {
        max-width: 720px;
        margin: 48px auto 0;
        padding-top: 16px;
        border-top: 1px solid #1f2937;
        color: #6b7280;
        font-size: 0.78rem;
      }
    </style>
  </head>
  <body>
    <main>
      <a class="back" href={`/${lang}/`}>← {ui.back}</a>
      <h1>{title}</h1>
      <p class="updated">{ui.updated}: {ui.date}</p>
      <slot />
    </main>
    <footer>© {new Date().getFullYear()} WeldWork — Irumbuliyur, Chennai 600059 · contact@weldwork.in</footer>
  </body>
</html>
