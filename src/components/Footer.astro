---
import { SITE } from '../config';
interface Props {
  activeScreen: 'home' | 'catalogue' | 'teams' | 'about';
}
const { activeScreen } = Astro.props;
const lang = Astro.url.pathname.startsWith('/ta') ? 'ta' : 'en';

const F = lang === 'ta'
  ? {
      quickLinks: "விரைவு இணைப்புகள்",
      home: "முகப்பு",
      catalogue: "பட்டியல்",
      team: "குழு",
      about: "எங்களைப் பற்றி",
      rights: "அனைத்து உரிமைகளும் பாதுகாக்கப்பட்டவை.",
      privacy: "தனியுரிமை",
      terms: "விதிமுறைகள்"
    }
  : {
      quickLinks: "Quick links",
      home: "Home",
      catalogue: "Catalogue",
      team: "Team",
      about: "About",
      rights: "All rights reserved.",
      privacy: "Privacy",
      terms: "Terms"
    };

// Site data for footer
const SITE_DATA = {
  phone: "+91 98405 62997",
  email: "contact@weldwork.in",
};
---
<footer class="app-nav-wrapper">
  <div class="app-nav-bg"></div>
  <nav class="app-nav" aria-label="Main navigation">
    <button class={`nav-tab ${activeScreen === 'home' ? 'active' : ''}`} data-screen="home" aria-label="Home">
      <i data-lucide="home" class="nav-icon"></i>
      <span>Home</span>
    </button>
    
    <div class="nav-tab-center" id="nav-tab-center">
      <div class="center-btn-longpress-ring"></div>
      <button class="center-btn-inner" id="app-center-btn" data-screen="catalogue" aria-label="Product Catalogue">
        <i data-lucide="layers" class="center-icon icon-catalogue"></i>
        <i data-lucide="arrow-up" class="center-icon icon-scroll-top"></i>
      </button>
    </div>
    
    <button class={`nav-tab ${activeScreen === 'teams' ? 'active' : ''}`} data-screen="teams" aria-label="Our Team">
      <i data-lucide="users" class="nav-icon"></i>
      <span>Team</span>
    </button>
  </nav>
</footer>

<div class="global-search-overlay hidden" id="global-search-overlay" aria-hidden="true" role="dialog" aria-label="Search">
  <div class="global-search-panel">
    <div class="global-search-header">
      <div class="global-search-input-wrap">
        <i data-lucide="search" class="global-search-icon"></i>
        <input type="search" id="global-search-input" class="global-search-input" placeholder="Search services, team, pages…" autocomplete="off" enterkeyhint="search" />
      </div>
      <button class="global-search-close" id="global-search-close" aria-label="Close search">
        <i data-lucide="x"></i>
      </button>
    </div>
    <div class="global-search-body" id="global-search-body">
      <div class="global-search-empty" id="global-search-empty">
        <i data-lucide="search" class="global-search-empty-icon"></i>
        <p class="global-search-empty-text">Type to search everything</p>
      </div>
    </div>
  </div>
</div>
