---
// Redirect / to /en/ or /ta/ depending on browser language preference
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="refresh" content="0;url=/en/" />
  <script is:inline>
    const lang = navigator.language.startsWith('ta') ? 'ta' : 'en';
    window.location.replace(`/${lang}/`);
  </script>
</head>
<body>
</body>
</html>
