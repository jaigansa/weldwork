---
const lang = Astro.url.pathname.startsWith('/ta') ? 'ta' : 'en';
const copy = lang === 'ta'
  ? { code: '404', title: 'பக்கம் கிடைக்கவில்லை', text: 'நீங்கள் தேடும் பக்கம் நகர்த்தப்பட்டோ அல்லது அகற்றப்பட்டோ இருக்கலாம்.', home: 'முகப்பு' }
  : { code: '404', title: 'Page not found', text: 'The page you are looking for may have been moved or removed.', home: 'Home' };
const homePath = `/${lang}/`;
---

<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="noindex">
    <title>{copy.code} — {copy.title}</title>
    <style>
      body {
        margin: 0;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--bg-primary, #090d16);
        color: var(--text-primary, #f8fafc);
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
        text-align: center;
        padding: 24px;
      }
      .code {
        font-size: 5rem;
        font-weight: 800;
        line-height: 1;
        background: linear-gradient(135deg, var(--text-primary, #f8fafc) 30%, var(--accent-color, #ff9f1c));
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
      }
      h1 { font-size: 1.25rem; margin: 12px 0 6px; }
      p { color: var(--text-secondary, #94a3b8); font-size: 0.9rem; margin: 0 0 24px; }
      a {
        display: inline-block;
        padding: 10px 22px;
        border-radius: 10px;
        background: var(--accent-color, #ff9f1c);
        color: #090d16;
        font-weight: 700;
        text-decoration: none;
      }
      a:hover { filter: brightness(1.1); }
    </style>
  </head>
  <body>
    <main>
      <div class="code">{copy.code}</div>
      <h1>{copy.title}</h1>
      <p>{copy.text}</p>
      <a href={homePath}>{copy.home}</a>
    </main>
  </body>
</html>
